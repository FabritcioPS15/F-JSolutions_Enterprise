# URL pública del sitio, usada para metadata, canonical, sitemap y robots.
NEXT_PUBLIC_SITE_URL=https://fjsolutions.pe

# API interna (catálogo y mesa de ayuda). Solo servidor.
API_INTERNAL_URL=http://localhost:4000/api/v1
HELPDESK_API_URL=http://localhost:4000/api/v1

# ─── Cuentas de clientes ─────────────────────────────────────────────────────
# Carpeta compartida con el panel. Por defecto: <repo>/.data
# FJ_DATA_DIR=
# URL base de los enlaces de confirmación enviados por correo.
CUSTOMER_APP_URL=http://localhost:3000
# Secreto para firmar la sesión de clientes. Si falta, se usa ADMIN_SESSION_SECRET.
CUSTOMER_SESSION_SECRET=

# ─── Acceso con Google y Facebook (opcional) ────────────────────────────────
# Sin credenciales, los botones sociales quedan desactivados.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# URL pública de la tienda para armar las redirect_uri de OAuth (opcional).
CUSTOMER_OAUTH_BASE_URL=http://localhost:3000

# ─── Correo de verificación ─────────────────────────────────────────────────
# Sin SMTP, el correo queda en `.data/outbox` y se puede ver desde el panel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=F&J Systems <no-reply@fjsolutions.pe>
