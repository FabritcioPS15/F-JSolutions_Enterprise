# URLs del ecosistema SparkTree
NEXT_PUBLIC_URL_SYSTEMS=http://localhost:3000
NEXT_PUBLIC_STORE_APP_URL=http://localhost:3006
NEXT_PUBLIC_GROUP_APP_URL=http://localhost:3008
