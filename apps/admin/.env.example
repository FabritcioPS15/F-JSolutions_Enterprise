# API interna usada por los Route Handlers del servidor Next.
API_INTERNAL_URL=http://localhost:4000/api/v1

# ─── Cuentas web de clientes ─────────────────────────────────────────────────
# Debe apuntar a la misma carpeta que usa la tienda. Por defecto: <repo>/.data
# FJ_DATA_DIR=

# SMTP para reenviar confirmaciones desde el panel (opcional).
# Sin SMTP, el correo queda en `.data/outbox` y se muestra en la bandeja del panel.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=F&J Systems <no-reply@fjsolutions.pe>
