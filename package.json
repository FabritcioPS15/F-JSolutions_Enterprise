{
  "name": "fj-solutions-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --filter \"./apps/**\" dev",
    "dev:web": "pnpm --filter fj-solutions-web dev",
    "dev:admin": "pnpm --filter fj-solutions-admin dev",
    "dev:api": "pnpm --filter fj-solutions-backend dev",
    "build": "pnpm --filter \"./apps/**\" build",
    "build:contracts": "pnpm --filter @fj-solutions/contracts build",
    "db:migrate": "cd apps/api && npx prisma migrate dev --schema=../../database/schema.prisma",
    "db:studio": "cd apps/api && npx prisma studio --schema=../../database/schema.prisma",
    "db:generate": "cd apps/api && npx prisma generate --schema=../../database/schema.prisma",
    "db:seed": "pnpm --filter fj-solutions-backend db:seed",
    "test": "pnpm --filter fj-solutions-backend test"
  },
  "devDependencies": {
    "@prisma/client": "^5.22.0",
    "prisma": "5.14.0"
  }
}
