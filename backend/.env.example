# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ── Base de datos ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/fj_solutions_db"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# ── Correo (Nodemailer) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@fjsolutions.pe
SMTP_PASS=your_app_password
EMAIL_FROM="FJ Tech Solutions <no-reply@fjsolutions.pe>"

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Uploads ───────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=./uploads