{
  "name": "@fj-solutions/contracts",
  "version": "1.0.0",
  "description": "Tipos compartidos entre web y api",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "admin": [
        "./dist/admin.d.ts"
      ],
      "domain": [
        "./dist/domain.d.ts"
      ],
      "permissions": [
        "./dist/permissions.d.ts"
      ],
      "customer-accounts": [
        "./dist/customer-accounts.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "default": "./dist/admin.js"
    },
    "./domain": {
      "types": "./dist/domain.d.ts",
      "default": "./dist/domain.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "default": "./dist/permissions.js"
    },
    "./customer-accounts": {
      "types": "./dist/customer-accounts.d.ts",
      "default": "./dist/customer-accounts.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "typescript": "^5.4.5"
  }
}
