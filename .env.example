# ─── Entorno ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://fj_solutions:fj_solutions_password@localhost:5432/fj_solutions

# Credenciales usadas por el contenedor de PostgreSQL en docker-compose.
POSTGRES_USER=fj_solutions
POSTGRES_PASSWORD=fj_solutions_password
POSTGRES_DB=fj_solutions

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=4000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=./uploads

# ─── Seguridad ───────────────────────────────────────────────────────────────
# Usa secretos de al menos 32 caracteres y distintos entre sí.
JWT_SECRET=change-me-dev-jwt-secret-0123456789abcdef
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-0123456789
JWT_REFRESH_EXPIRES_IN=30d

# ─── Seed ────────────────────────────────────────────────────────────────────
# Si SEED_ADMIN_PASSWORD no se define, el seed usa una contraseña de desarrollo.
SEED_ADMIN_EMAIL=admin@fjsolutions.com.pe
SEED_ADMIN_NAME=Administrador F&J
SEED_ADMIN_PASSWORD=

# ─── Correo (opcional) ───────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=F&J Systems <no-reply@fjsolutions.pe>

# ─── Frontends ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* se expone al navegador; el resto es solo para el servidor.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://fjsolutions.pe

# URL interna para los proxies del servidor Next (sin exponerla al navegador).
API_INTERNAL_URL=http://localhost:4000/api/v1
HELPDESK_API_URL=http://localhost:4000/api/v1
