# ─── Entorno ─────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://fj_solutions:fj_solutions_password@localhost:5432/fj_solutions

# Credenciales usadas por el contenedor de PostgreSQL en docker-compose.
POSTGRES_USER=fj_solutions
POSTGRES_PASSWORD=fj_solutions_password
POSTGRES_DB=fj_solutions

# ─── API ─────────────────────────────────────────────────────────────────────
PORT=4000
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=./uploads

# ─── Seguridad ───────────────────────────────────────────────────────────────
# Usa secretos de al menos 32 caracteres y distintos entre sí.
JWT_SECRET=change-me-dev-jwt-secret-0123456789abcdef
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-dev-refresh-secret-0123456789
JWT_REFRESH_EXPIRES_IN=30d

# Clave independiente para cifrar secretos TOTP, hashear códigos de
# recuperación y firmar el token temporal del desafío 2FA.
TWO_FACTOR_SECRET=change-me-dev-two-factor-secret-0123456789

# ─── Seed ────────────────────────────────────────────────────────────────────
# Si SEED_ADMIN_PASSWORD no se define, el seed usa una contraseña de desarrollo.
SEED_ADMIN_EMAIL=admin@fjsolutions.com.pe
SEED_ADMIN_NAME=Administrador F&J
SEED_ADMIN_PASSWORD=

# ─── Correo (opcional) ───────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=F&J Systems <no-reply@fjsolutions.pe>

# ─── Cuentas web de clientes ─────────────────────────────────────────────────
# Carpeta compartida por la tienda y el panel. Por defecto: <repo>/.data
# FJ_DATA_DIR=
# URL base de los enlaces de confirmación que se envían por correo.
CUSTOMER_APP_URL=http://localhost:3000
# Secreto para firmar la sesión de clientes. Si falta, se usa ADMIN_SESSION_SECRET.
CUSTOMER_SESSION_SECRET=
# Acceso social (opcional). Sin credenciales, los botones quedan desactivados.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# URL pública de la tienda para armar las redirect_uri de OAuth (opcional).
CUSTOMER_OAUTH_BASE_URL=http://localhost:3000

# ─── Frontends ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_* se expone al navegador; el resto es solo para el servidor.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://fjsolutions.pe

# URL interna para los proxies del servidor Next (sin exponerla al navegador).
API_INTERNAL_URL=http://localhost:4000/api/v1
HELPDESK_API_URL=http://localhost:4000/api/v1
